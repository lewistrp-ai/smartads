{
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/taller-meta-ads",
      "destination": "/taller-meta-ads/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
