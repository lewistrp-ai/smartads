# Backend Port
PORT=3001
BACKEND_URL=http://localhost:3001

# Meta Graph API Credentials (App Dashboard)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# For Local Testing without full OAuth Flow
# Get these from the Meta Graph API Explorer
META_DEV_ACCESS_TOKEN=your_long_lived_dev_token_here
TEST_AD_ACCOUNT_ID=123456789012345

# --- Supabase (para que el webhook actualice el acceso del usuario) ---
# La misma URL del proyecto que usa el frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
# SERVICE ROLE key (Supabase > Settings > API). ¡SOLO en el backend, nunca en el frontend!
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- Hotmart Webhook ---
# Token "Hottok" que Hotmart muestra al crear el Webhook (Herramientas > Webhook/API).
HOTMART_HOTTOK=tu_hottok_de_hotmart_aqui
# (Opcional) ID del producto de la membresía recurrente en Hotmart. Si lo pones aquí,
# no necesitas editar server/hotmartProducts.js para la membresía.
HOTMART_MEMBERSHIP_PRODUCT_ID=
